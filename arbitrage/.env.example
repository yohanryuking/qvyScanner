# ══════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE NOTIFICACIONES - QvaPay Arbitrage Monitor
# ══════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# OPCIÓN 1: Twilio WhatsApp (Recomendado para producción)
# ────────────────────────────────────────────────────────────────
# 1. Crear cuenta en: https://www.twilio.com/
# 2. Activar WhatsApp Sandbox
# 3. Obtener credenciales del dashboard

NOTIFICACIONES_TWILIO=false
TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+5353123456

# ────────────────────────────────────────────────────────────────
# OPCIÓN 2: CallMeBot WhatsApp (Gratuito y Simple) ⭐ RECOMENDADO
# ────────────────────────────────────────────────────────────────
# 1. Agrega +34 644 44 71 67 a tus contactos de WhatsApp
# 2. Envíale: "I allow callmebot to send me messages"
# 3. Te responderá con tu API Key
# Más info: https://www.callmebot.com/blog/free-api-whatsapp-messages/

NOTIFICACIONES_CALLMEBOT=false
CALLMEBOT_PHONE=5353123456
CALLMEBOT_API_KEY=123456

# ────────────────────────────────────────────────────────────────
# OPCIÓN 3: Telegram (Alternativa)
# ────────────────────────────────────────────────────────────────
# 1. Habla con @BotFather en Telegram
# 2. Crea un bot con /newbot
# 3. Obtén tu chat_id hablando con @userinfobot

NOTIFICACIONES_TELEGRAM=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ══════════════════════════════════════════════════════════════
# INSTRUCCIONES DE USO:
# ══════════════════════════════════════════════════════════════
# 
# 1. Copia este archivo como .env:
#    cp .env.example .env
#
# 2. Edita .env con tus credenciales
#
# 3. Instala dotenv:
#    npm install dotenv
#
# 4. El monitor cargará automáticamente las variables
#
# 5. O exporta manualmente:
#    export NOTIFICACIONES_CALLMEBOT=true
#    export CALLMEBOT_PHONE="5353123456"
#    export CALLMEBOT_API_KEY="123456"
#
# ══════════════════════════════════════════════════════════════
